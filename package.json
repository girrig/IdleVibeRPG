{
  "name": "idle-vibe-rpg",
  "private": true,
  "version": "0.1.13",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "yarn test:unit && yarn test:browser",
    "test:unit": "vitest run --exclude src/ui/components/MapView.test.js --exclude src/scenes/MainScene.test.js",
    "test:browser": "vitest run src/ui/components/MapView.test.js src/scenes/MainScene.test.js --browser",
    "test:watch": "vitest",
    "prepare": "husky",
    "release": "npm version patch && git push",
    "release:prepare": "npm version patch --no-git-tag-version"
  },
  "devDependencies": {
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-istanbul": "^4.0.18",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "playwright": "^1.58.1",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "simplex-noise": "^4.0.3"
  }
}
